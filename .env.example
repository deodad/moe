OPENAI_API_KEY=
# Required in production; the browser will prompt for this shared password.
MOE_ACCESS_PASSWORD=
# Optional; defaults to moe.
MOE_ACCESS_USERNAME=moe
# Optional: override the OpenAI API base URL.
OPENAI_API_BASE_URL=
# Optional: choose the conversation model. Web searches inherit the invoking model.
NANOCODEX_MODEL=gpt-5.6-luna
